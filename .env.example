# Database connection for finance-backend (Spring Boot)

DB_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema="finance-app"
DB_USERNAME=postgres
DB_PASSWORD=12345678

# AES-256 key สำหรับเข้ารหัสรหัสผ่านใน DB (base64 ของ 32 bytes) — สร้างด้วย: openssl rand -base64 32
# ห้ามหาย/ห้ามเปลี่ยน ไม่งั้นถอดรหัสผ่านเดิมไม่ได้ — สำรองไว้ที่ปลอดภัย
PASSWORD_ENC_KEY=

# secret สำหรับเซ็น JWT (base64 อย่างน้อย 32 bytes) — สร้างด้วย: openssl rand -base64 64
JWT_SECRET=

# true เมื่อรันผ่าน HTTPS (cookie จะส่งเฉพาะ HTTPS) — dev บน http ให้เป็น false
COOKIE_SECURE=false
